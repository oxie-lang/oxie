import std.env
import std.fs

data class WordStat(word: String, count: usize)

/// Counts words, ignoring case and punctuation.
fun count_words(text: String): [String: usize] {
    var counts = [:]
    for (word in text.split { c: char -> !c.is_alphanumeric() && c != '\'' }) {
        if (word.is_empty()) continue
        *counts.entry(word.to_lowercase()).or_insert(0) += 1
    }
    counts
}

fun top(counts: [String: usize], n: usize): [WordStat] {
    var stats = counts.iter().map { (w, c) -> WordStat(w.clone(), *c) }.to_list()
        .sorted_by { &it.word }
        .sorted_by_descending { it.count }      // stable: equal counts stay in word order
    stats.truncate(n)
    stats
}

fun main() throws {
    val path = env.args().nth(1) ?: "sample.txt"
    val text = fs.read_to_string(&path).context("cannot read '$path'")?
    val counts = count_words(text)
    val total: usize = counts.values().sum()
    println("$total words, ${counts.len()} distinct")
    for ((i, s) in top(counts, 5).iter().enumerate()) {
        val bar = "#".repeat(s.count)
        println("${i + 1}. ${s.word:<6} ${s.count} $bar")
    }
}

test "counts case-insensitively" {
    val c = count_words("A a b")
    assert_eq(c["a"], 2)
    assert_eq(c["b"], 1)
    assert(c.get("z") == null)
}
