/// A quick tour of oxie. Run it with `oxie run`.

data class Person(name: String, age: u32)

fun greet(p: Person): String = when {
    p.age < 18 -> "Hi ${p.name}!"
    else -> "Hello, ${p.name}."
}

fun main() {
    // values and variables
    val language = "Oxie"
    var count = 0
    count += 1

    // string templates
    println("Welcome to $language (run #$count)")

    // collections and lambdas
    val people = listOf(Person("Ada", 36), Person("Tim", 12), Person("Grace", 45))
    val adults = people.filter { it.age >= 18 }.map { it.name.clone() }
    println("adults: ${adults.join(", ")}")

    // control flow is an expression
    for (p in people) println(greet(p))
    val oldest = people.max_by_key { it.age }
    println("oldest: ${oldest?.name ?: "nobody"}")

    // null safety
    val nickname: String? = null
    println("nickname: ${nickname ?: "none"}")

    // errors without boilerplate
    val parsed = "42".parse<i32>() ?: 0
    println("parsed: $parsed")
}
