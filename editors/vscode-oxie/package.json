{
  "name": "oxie",
  "displayName": "Oxie",
  "description": "Oxie language support: syntax highlighting, the Oxie language server (diagnostics, completion, hover with the generated Rust, go to definition, rename, formatting), run and test buttons, snippets.",
  "version": "0.1.0",
  "publisher": "oxie-lang",
  "license": "MIT OR Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxie-lang/oxie",
    "directory": "editors/vscode-oxie"
  },
  "homepage": "https://oxie.bkymz.net",
  "bugs": "https://github.com/oxie-lang/oxie/issues",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "oxie",
    "rust",
    "kotlin",
    "language server"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:*.oxi",
    "workspaceContains:src/*.oxi",
    "workspaceContains:*/src/*.oxi"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting and snippets work in Restricted Mode. The language server and the run commands need a trusted workspace, because building the code runs its build scripts.",
      "restrictedConfigurations": [
        "oxie.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The language server and the run commands need the files on disk."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "oxie",
        "aliases": [
          "Oxie",
          "oxie"
        ],
        "extensions": [
          ".oxi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/oxie-light.svg",
          "dark": "./images/oxie-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "oxie",
        "scopeName": "source.oxie",
        "path": "./syntaxes/oxie.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.rust": "rust"
        }
      },
      {
        "scopeName": "markdown.oxie.codeblock",
        "path": "./syntaxes/oxie-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.oxie": "oxie"
        }
      }
    ],
    "snippets": [
      {
        "language": "oxie",
        "path": "./snippets/oxie.json"
      }
    ],
    "configuration": {
      "title": "Oxie",
      "properties": {
        "oxie.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `oxie` command, used for the language server and to run files. Empty: `oxie` from the `PATH`, or `~/.cargo/bin/oxie`. A relative path is relative to the first workspace folder."
        },
        "oxie.cargoCheck": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run `cargo check` when an Oxie file is opened or saved, and show rustc's errors and warnings on the `.oxi` lines."
        },
        "oxie.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between VS Code and the Oxie language server in its output channel."
        }
      }
    },
    "configurationDefaults": {
      "[oxie]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "commands": [
      {
        "command": "oxie.run",
        "title": "Run File",
        "category": "Oxie",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.runRelease",
        "title": "Run File (Release)",
        "category": "Oxie",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.test",
        "title": "Run Tests in File",
        "category": "Oxie",
        "icon": "$(beaker)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.runTest",
        "title": "Run Test",
        "category": "Oxie",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.showGeneratedRust",
        "title": "Show Generated Rust",
        "category": "Oxie",
        "icon": "$(open-preview)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.restartServer",
        "title": "Restart Language Server",
        "category": "Oxie",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "oxie.showOutput",
        "title": "Show Language Server Output",
        "category": "Oxie"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "oxie.run",
          "when": "resourceLangId == oxie && resourceScheme == file",
          "group": "navigation@0"
        },
        {
          "command": "oxie.runRelease",
          "when": "resourceLangId == oxie && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "oxie.test",
          "when": "resourceLangId == oxie && resourceScheme == file",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "oxie.showGeneratedRust",
          "when": "resourceLangId == oxie && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "oxie.run",
          "when": "editorLangId == oxie"
        },
        {
          "command": "oxie.runRelease",
          "when": "editorLangId == oxie"
        },
        {
          "command": "oxie.test",
          "when": "editorLangId == oxie"
        },
        {
          "command": "oxie.runTest",
          "when": "false"
        },
        {
          "command": "oxie.showGeneratedRust",
          "when": "editorLangId == oxie"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "oxie",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The oxie command to run: run, build, check, test, fmt, ..."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments after the command."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "check": "tsc -p . && tsc -p test --noEmit",
    "test": "npm run test:grammar && npm run test:integration",
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/*.oxi\"",
    "test:integration": "node scripts/build.mjs && tsc -p test && node out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "mocha": "11.7.6",
    "typescript": "5.9.3",
    "vscode-tmgrammar-test": "0.1.3"
  }
}
