// Errors explained from declarations in another file of the crate (text.oxi).

import text::{describe, first_word, keep, Counter, Tag, Total}

fun main() {
    val nums = vec[1, 2, 3]
    val kept = keep(nums)
    println("${kept.len()} ${nums.len()}")
    // error: 8: `keep` keeps it (it returns `v`)
    val tag = Tag("new".to_string())
    println(describe(tag))
    println(tag.name)
    // error: 12: fix: let `describe` borrow it (without `own`) (in src/text.oxi): `pub fun describe(t: Tag): String = "#${t.name}"`
    val line = "hello world".to_string()
    val w = first_word(line, " ".to_string())
    // error: 15: name the lifetime yourself (in text.oxi): `fun first_word<'a>(text: &'a str, sep: &str): &'a str`
    println(w)
}

fun show(t: Total) {
    println("$t")
    // error: 21: print its debug form with a `:?` spec
}

fun count() {
    val counter = Counter()
    counter.hit()
    // error: 27: calling `counter.hit()` changes `counter`: Oxie made `hit` take `&mut self` because it calls `hits.push()`
}
