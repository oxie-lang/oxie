// Declarations the errors in main.oxi depend on.

fun keep(v: Vec<i32>): Vec<i32> = v
// error: 3: `keep` keeps it: it returns `v`

data class Tag(name: String)
// used as a value (`describe_all`): its signature stays as written, so the move error and its fix stay
pub fun describe(t: Tag): String = "#${t.name}"

data class Total(sum: i32)

fun first_word(text: &str, sep: &str): &str = text.split(sep).next().unwrap_or(text)

class Counter(var hits: Vec<i32> = vec[]) {
    fun hit() { hits.push(1) }
    // error: 15: `hit` changes its object here, so it takes `&mut self`
}

fun describe_all(tags: Vec<Tag>): Vec<String> = tags.into_iter().map(describe).collect()
