// Errors caused by what Oxie decided say why it decided that.

fun keep(own v: Vec<i32>): Vec<i32> = v
fun first_word(text: &str, sep: &str): &str = text.split(sep).next().unwrap_or(text)

fun main() {
    val nums = vec[1, 2, 3]
    val kept = keep(nums)
    println("${kept.len()} ${nums.len()}")
    // error: 9: `keep` keeps it (it returns `v`)
    val line = "hello world".to_string()
    val w = first_word(line, " ".to_string())
    // error: 12: fun first_word<'a>(text: &'a str, sep: &str): &'a str
    println(w)
}

class Counter(var hits: Vec<i32> = vec[0]) {
    fun hit() { hits.push(1) }
    fun first(): &i32 = &hits[0]
}

// calling a method Oxie made `&mut self` says why it changes the value
fun count() {
    val c = Counter()
    c.hit()
    // error: 25: `hit` changes its object here, so it takes `&mut self`
    // error: 25: calling `c.hit()` changes `c`: Oxie made `hit` take `&mut self` because it calls `hits.push()`
    var d = Counter()
    val f = d.first()
    d.hit()
    // error: 30: calling `d.hit()` changes `d`: Oxie made `hit` take `&mut self`
    println(f)
}

class Stack(var items: Vec<i32> = vec[]) {
    fun push(x: i32) { items.push(x) }
}

// a `Vec`'s `push` isn't the `push` of `Stack`
fun other() {
    val v: Vec<i32> = vec[]
    v.push(1)
    // error: 42: `v` is a `val`, so it can't be changed
    // not: 42: Oxie made `push` take `&mut self`
}
