data class Point(x: i32, y: i32)

fun add(a: i32, b: i32): i32 = a + b

fun main() {
    val p = Point(1, 2)
    val s: String = add(1, 2)
    // error: 7: mismatched types
    println(p.z)
    // error: 9: no field `z`
    val n = add("one", 2)
    // error: 11: mismatched types
}

data class Address(city: String?)
data class User(name: String, address: Address?)

// `?.` reads `city` through the borrowed `u`, so `?: "unknown"` is a `&str`
fun city(u: &User): String = u.address?.city ?: "unknown"
// error: 19: fix: use a copy (`.clone()`): `fun city(u: &User): String = u.address?.city.clone() ?: "unknown"`

// the name read in a template is pointed at, not the whole `println`
fun show(at: Point) {
    println("point at: $at here")
    // error: 24:24: has no text form for `$` templates
}
