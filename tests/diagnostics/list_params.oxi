// A list or map parameter that a function keeps (returns or stores) is `own`: the error for a
// value moved into it says why the function keeps it, and offers no fix that would borrow it.

fun keep(own v: [i32]): [i32] = v

fun count(own m: [String: i32]): usize = m.into_iter().count()

fun main() {
    val nums: [i32] = [1, 2]
    val kept = keep(nums)
    println("${kept.len()} ${nums.len()}")
    // error: 11: `keep` keeps it (it returns `v`)
    // not: 11: borrow it
    val ages: [String: i32] = ["ada": 36]
    println(count(ages))
    println(ages.len())
    // error: 16: `count` keeps it (it calls `.into_iter()` on `m`
    // not: 16: borrow it
}
