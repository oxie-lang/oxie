// Printing a value without a text form offers to print its debug form.

fun main() {
    val xs = vec[1, 2]
    println(xs) // error: 5: fix: print the debug form (`:?`): `println("${xs:?}")`
    val ys = vec["a"]
    print(ys.clone()) // error: 7: fix: print the debug form (`:?`): `print("${ys.clone():?}")`
}
