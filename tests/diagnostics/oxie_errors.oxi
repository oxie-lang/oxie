// Errors Oxie reports itself, before rustc runs.

fun make(): () -> i32 {
    { 42 }
}

fun main() {
    var n = 0
    {
        n += 1
    }
    // error: 9: this `{ }` is a lambda, and it is never called
    run {
        n += 1
    }
    println("$n ${make()()}")
}

interface Listener { fun register(list: &mut Vec<Watcher>) }
shared class Watcher : Listener {
    override fun register(list: &mut Vec<Watcher>) {
        list.push(this)
    }
}
// error: 21: `register` implements an interface method, so it can't pass `this` on

fun check(x: i32) {
    if (x < 0) throw "negative"
}
// error: 28: `throw` in a function that doesn't declare `throws`
