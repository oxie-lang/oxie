// A null check unwraps local variables and parameters; a field gets an error that says how to
// unwrap it.

data class User(name: String, email: String?)

fun main() {
    val u = User("a", null)
    if (u.email != null) println(u.email.to_uppercase()) // error: 8: fix: unwrap `u.email` (`val email = &u.email`): `if (val email = &u.email) println(email.to_uppercase())`
    if (u.email == null) return
    println(u.email.len()) // error: 10: a null check unwraps only local variables and parameters
}

fun twice(name: String?) {
    if (val n = name) println(n.len())
    println("${name:?}") // error: 15: fix: unwrap a reference (`&name`): `if (val n = &name) println(n.len())`
}
