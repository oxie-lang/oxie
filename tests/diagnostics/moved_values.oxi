// A moved value gets the fix `.clone()` only when its type implements `Clone`, and no fix that
// is one part of a rustc suggestion that edits several places.

import std::sync::{Mutex, MutexGuard}
import std::thread

// keeps its guards, so they unlock when it returns
fun release(guards: Vec<MutexGuard<i32>>) = println("releasing ${guards.len()}")

class Token(val text: String)

fun show(t: Token) = println(t.text)                     // used as a value: keeps its parameter type

fun main() {
    val m = Mutex::new(0)
    val gs = vec[m.lock().unwrap()]
    release(gs)
    println(gs.len())
    // error: 18: Finish using `gs` before the call.
    // not: 18: .clone()
    val t = Token("a".to_string())
    show(t)
    println(t.text)
    // error: 23: Let `show` borrow the value instead.
    // not: 23: .clone()
    val name = "worker".to_string()
    val h = thread::spawn(move { println(name) })
    println(name)
    // error: 28: `name` was moved
    // error: 28: fix: give the lambda its own copy of `name`
    // not: 28: let value
    h.join().unwrap()
    vec[Token("b".to_string())].into_iter().for_each(show)
}
