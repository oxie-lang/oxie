// A moved value gets the fix `.clone()` only when its type implements `Clone`, and no fix that
// is one part of a rustc suggestion that edits several places.

import std::sync::{Mutex, MutexGuard}
import std::thread

// takes its guards, so they unlock when it returns
fun release(own guards: Vec<MutexGuard<i32>>) = println("releasing ${guards.len()}")

class Token(val text: String)

fun show(own t: Token) = println(t.text)                 // takes it, and only reads it

fun main() {
    val m = Mutex::new(0)
    val gs = vec[m.lock().unwrap()]
    release(gs)
    println(gs.len())
    // error: 18: Finish using `gs` before the call.
    // not: 18: .clone()
    val t = Token("a".to_string())
    show(t)
    println(t.text)
    // error: 23: Finish using `t` before the call.
    // error: 23: fix: let `show` borrow it (without `own`): `fun show(t: Token) = println(t.text)
    // not: 23: .clone()
    val name = "worker".to_string()
    val h = thread::spawn(move { println(name) })
    println(name)
    // error: 29: `name` was moved
    // error: 29: fix: give the lambda its own copy of `name`
    // not: 29: let value
    h.join().unwrap()
    vec[Token("b".to_string())].into_iter().for_each(show)
}
