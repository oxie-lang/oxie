// Changing a `Copy` parameter offers `&mut`; a value moved into an `own` parameter that its
// function stores or returns gets no fix that would lend it, which couldn't compile: pass a copy
// instead. (A borrowed parameter that its function changes or keeps is an error of its own, in
// own_parameters.oxi.)
data class Counter(var n: i32)
class Tag(name: String)
class Holder(t: Tag)

fun bump(k: Counter) { k.n += 1; println(k.n) }
// error: 9: `k` is a parameter, so `bump` can't change it
// error: 9: fix: let `bump` change `k` (`&mut`)
fun store(own t: Tag): Holder = Holder(t)
pub fun keep(own v: Vec<i32>): Vec<i32> = v

fun main() {
    bump(Counter(1))
    val t = Tag("a")
    val h = store(t)
    println(t.name)
    // error: 19: `store` keeps it (it passes `t` to `Holder`, which keeps it)
    // not: 19: borrow it
    val v = vec[1]
    val k = keep(v)
    println("${v.len()} ${k.len()} ${h.t.name}")
    // error: 24: `keep` keeps it (it returns `v`)
    // not: 24: borrow it
}
