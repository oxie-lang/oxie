// `Some("text")` arms on a `String?` Oxie couldn't type: the fix is `.as_deref()`, not `.as_str()`.

rust {
    fn lookup() -> Option<String> {
        None
    }
}

fun main() {
    when (lookup()) {
        Some("hi") -> println("hi")
        // error: 11: compare the text inside with `.as_deref()`
        // error: 11: fix: use `.as_deref()`: `when (lookup().as_deref()) {`
        else -> println("?")
    }
}
