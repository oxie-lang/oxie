// A lambda parameter of an `Fn`, `fn` or tuple type: the `->` after `FnMut(String)`,
// `fn(&mut String)` or `(u32, usize)` ends the parameters, unless a type follows it and then
// another `->`.
fun shout(s: &mut String) = s.push('!')
fun main() {
    var lines = Vec<String>()
    val report = { file: &str, add: &mut dyn FnMut(String) -> add("checked $file") }
    report("a.scm", &mut { line: String -> lines.push(line) })
    report("b.scm", &mut { line -> lines.push(line) })
    println(lines.join(", "))

    val twice = { f: &dyn Fn(i32) -> i32 -> f(f(1)) }
    println(twice(&{ n: i32 -> n * 10 }))
    val boxed = { f: Box<dyn Fn(i32) -> i32>, n: i32 -> f(n) }
    println(boxed(Box.new { n: i32 -> n + 1 }, 4))
    var count = 0
    val each = { [count] f: &mut dyn FnMut(usize) -> f(count) }
    each(&mut { n: usize -> count = n + 1 })
    println(count)

    val apply = { text: &str, f: fn(&mut String) -> var t = text.to_string(); f(&mut t); t }
    println(apply("hi", shout))
    var pairs = vec[(3u32, 0usize), (5, 1), (3, 2)]
    pairs.sort_by { a: &(u32, usize), b: &(u32, usize) -> b.0.cmp(&a.0).then(a.1.cmp(&b.1)) }
    println("${pairs:?}")
}
