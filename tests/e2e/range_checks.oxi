// `x in a..b` is written without parentheses where Rust doesn't need them (rustc warns about
// unneeded ones), and with them where it does.

fun next(n: i32): i32 = n + 1

fun main() {
    val id = 2
    val ok = id in 1..=3
    println(ok)
    val x = 4
    if (x in 0..5) println("in")
    if (x !in 0..3) println("not in")
    val f = 0.5
    when {
        f in 0.0..1.0 -> println("unit")
        else -> println("other")
    }
    println(x in 0..5 == ok)
    println(x in 0..5 && id in 2..4)
    println(!(x in 0..3))
    println(next(x) in 0..5)
    println(next(x) !in 0..5)
    val flag = next(x) in 5..9 || false
    println(flag)
    if (next(x) in 0..9) println("block")
    println("${x in 1..9}")
    val lo = 3
    for (n in vec[1, 6, 7, 5]) {
        println(when (n) {
            in 0..lo, in 6..lo + 5 if n % 2 == 0 -> "even edge"
            in 0..lo, in 6..lo + 5 -> "edge"
            else -> "middle"
        })
    }
}
