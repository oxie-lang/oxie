// Variables built empty (`vec[]`, `mutableListOf<i32>()`, `Vec::new()`, `HashMap<K, V>()`, a
// generic class with its type arguments) have a known type: they are lent `&mut` to functions,
// `m[k] = v` inserts, and calls of their methods get defaults, names and contexts.
import std::collections::HashMap

fun fill(out: &mut Vec<i32>) = out.push(1)
fun fill_map(m: &mut HashMap<String, i32>) { m.insert("k".to_string(), 1) }

class Log(var lines: Vec<String> = vec[]) {
    fun add(line: String) = lines.push(line)
}

context(log: &mut Log)
class Stack<T>(var items: Vec<T> = vec[]) {
    fun push(own x: T, times: usize = 1) {
        repeat(times) { log.add("push") }
        items.push(x)
    }
}

fun main() {
    var a = vec[]
    fill(a)
    var b = mutableListOf<i32>()
    fill(b)
    var c = Vec::new()
    fill(c)
    var d = Vec::<i32>::new()
    fill(d)
    var e = mutableListOf()
    fill(e)
    println("${a.len()} ${b.len()} ${c.len()} ${d.len()} ${e.len()}")

    var log = Log()
    var s = Stack<i32>()
    s.push(1)
    s.push(2, times = 2)
    println("${s.items.len()} ${log.lines.len()}")

    var m = HashMap<String, i32>()
    m["z".to_string()] = 4
    fill_map(m)
    var n = mutableMapOf<String, i32>()
    n["y".to_string()] = 5
    var o = std::collections::HashMap::<String, i32>::new()
    o["q".to_string()] = 1
    for ((_, v) in o) *v += 10
    var p = HashMap::new()
    fill_map(p)
    println("${m.len()} ${n["y"]} ${o["q"]} ${p.len()}")
}
