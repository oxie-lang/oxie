// A parameter is borrowed unless it says `own`. A function that takes its list with `own` drops
// it when it returns, as in Rust: a value with `Drop` runs it there, and a `MutexGuard` unlocks
// there. A borrowed list is dropped by the caller.
import std::sync::{Mutex, MutexGuard}

class Noisy(val name: String)

impl Drop for Noisy {
    mut fun drop() { println("drop $name") }
}

// holds a `Noisy`, so dropping it runs code too
class Holder(val inner: Noisy)

// `Drop` written in Rust
class Logged(val id: i32)

rust {
    impl Drop for Logged {
        fn drop(&mut self) {
            println!("drop logged {}", self.id);
        }
    }
}

data class Point(val x: i32, val y: i32)

fun count(own xs: Vec<Noisy>) = println("count ${xs.len()}")
fun count_held(own xs: Vec<Holder>) = println("held ${xs.len()}: ${xs[0].inner.name}")
fun count_logged(own xs: Vec<Logged>) = println("logged ${xs.len()}")
fun size<T>(own xs: Vec<T>): usize = xs.len()
fun release(own guards: Vec<MutexGuard<i32>>) = println("releasing ${guards.len()}")

// borrowed: the caller keeps its list
fun peek(xs: Vec<Noisy>) = println("peek ${xs.len()}")
fun sum_x(ps: Vec<Point>): i32 = ps.iter().map { it.x }.sum()
fun longest(names: Vec<String>): usize = names.iter().map { it.len() }.max().unwrap_or(0)

fun main() {
    val xs = vec[Noisy("a"), Noisy("b")]
    count(xs)
    println("after count")

    val held = vec[Holder(Noisy("c"))]
    count_held(held)
    println("after held")

    val logs = vec[Logged(1)]
    count_logged(logs)
    println("after logged")

    val ds = vec[Noisy("d")]
    val n = size(ds)
    println("size $n")

    val m = Mutex::new(0)
    val gs = vec[m.lock().unwrap()]
    release(gs)
    println("unlocked: ${m.try_lock().is_ok()}")

    val ps = vec[Point(1, 2), Point(3, 4)]
    println("${sum_x(ps)} ${sum_x(ps)}")
    val names = vec["ada".to_string(), "grace".to_string()]
    println("${longest(names)} ${names:?}")

    val es = vec[Noisy("e")]
    peek(es)
    println("after peek")
}
