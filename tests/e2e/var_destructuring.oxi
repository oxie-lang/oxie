// `var (x, y)` makes only the parts that change mutable (no warnings for the others), and
// `val (x, var y)` declares only `y` changeable

fun fill(v: &mut Vec<i32>) { v.push(9) }

fun main() {
    var (x, y) = (3, 4)
    x += 1
    println("$x $y")
    var (a, b, c) = (vec[1], vec[2], 5)
    a.push(2)
    fill(b)
    println("${a:?} ${b:?} $c")
    val (first, var rest) = (1, vec[2])
    rest.push(first)
    println("$first ${rest:?}")
}
